# Copy to .env and fill in values. Never commit .env.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/atellixcareer

# Set to "memory" to run without a database (demo mode)
# DB_MODE=memory

# Port for the API server
PORT=4000

# Comma-separated allowed origins for the frontend
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# LLM provider for resume parsing / plan generation (optional —
# without a key the API returns deterministic demo analyses)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
