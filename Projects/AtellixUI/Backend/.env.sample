# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS allow-list)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# Optional in development; server falls back gracefully to in-memory store if omitted
MONGODB_URI=mongodb://localhost:27017/atellixui

# Email Notifications (Optional - Nodemailer for contact inquiries)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=admin@atellixui.dev

# JWT Secret (for future auth / admin routes)
JWT_SECRET=super-secret-key-change-in-production

