    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
