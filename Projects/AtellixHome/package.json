  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{js,jsx,css}\" \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,jsx}\" \"*.{js,mjs,json,md}\"",
